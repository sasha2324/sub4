# Copia questo file in .env e metti i tuoi valori. .env è escluso da git.

# App Strava: https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Integrazione Notion (solo per strava_notion_sync.py)
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Frequenza cardiaca massima, per stimare le zone se mancano quelle di Strava
HR_MASSIMA=190
